MINERU_API_KEY=<you_api_key>
# ==================== AI修改 开始 ====================
# 语言模型和视觉模型只需切换这一项即可在两个平台间切换。
MODEL_PROVIDER=modelscope

# 魔搭配置；旧的 MODA_API_KEY / LLM_MODEL_NAME / VL_MODEL_NAME 也继续兼容。
MODELSCOPE_API_KEY=<modelscope_api_key>
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_LLM_MODEL=Qwen/Qwen3.8-27B
MODELSCOPE_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct

# OpenRouter 配置；语言和视觉默认都使用用户指定的 dots 模型。
OPENROUTER_API_KEY=<openrouter_api_key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_VL_MODEL=dots-studio/dots-3-note-preview:free
# ==================== AI修改 结束 ====================

# 旧版魔搭变量(保留兼容，不再作为切换入口)
MODA_API_KEY=<modelscope_api_key>
VL_MODEL_API_KEY=<>
VL_MODEL_BASE_URL=<>
VL_MODEL_NAME=<>
# 所有语言/视觉模型共用的生成温度；未设置时兼容读取 VL_MODEL_TEMPERATURE。
MODEL_TEMPERATURE=<>
VL_MODEL_TEMPERATURE=<>
LLM_MODEL_NAME=<>

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=<>
# 访问密钥
MINIO_ACCESS_KEY=<>
# 私有密钥
MINIO_SECRET_KEY=<>
# 存储桶名称
MINIO_BUCKET_NAME=<>
# 图片上传目录
MINIO_IMG_DIR=<>

# ====================
# Object Storage (Embedding)
# ====================


# 嵌入模型
EMBEDDING_MODEL=<>
# 向量化设备
DEVICE=<>
# 精度训练
USE_FP16=<>
